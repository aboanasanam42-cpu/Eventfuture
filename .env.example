# MEXC API Credentials (Both MEXC_SECRET_KEY and MEXC_API_SECRET are supported)
MEXC_API_KEY="your_mexc_api_key_here"
MEXC_SECRET_KEY="your_mexc_secret_key_here"
MEXC_API_SECRET="your_mexc_secret_key_here"

# Trading Bot Configuration
SYMBOL="BTCUSDT"
TRADE_AMOUNT_USDT="3.0"
CYCLE_DURATION_MINUTES="10"
TIMEFRAME_INDICATOR="15m"
MAX_DAILY_LOSS_USDT="9.0"
MAX_CONSECUTIVE_LOSSES="3"
TRADING_MODE="simulation" # 'simulation' (paper-trading safe mode) or 'live' (real orders)
TRAILING_TP_ENABLED="false"
PYTHONUNBUFFERED="1"
PORT="3000"

# GEMINI_API_KEY: Optional
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL
APP_URL="MY_APP_URL"

